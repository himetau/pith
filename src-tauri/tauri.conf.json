{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pith",
  "version": "0.2.0",
  "identifier": "com.himetau.pith",
  "build": {
    "frontendDist": "../dist/ui",
    "beforeBuildCommand": "npm run build:ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:",
      "assetProtocol": { "enable": true, "scope": ["$HOME/**", "/tmp/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "category": "DeveloperTool",
    "shortDescription": "A desktop for pi",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "resources": { "../ext": "ext", "../prompts": "prompts" },
    "linux": { "deb": { "depends": [] } }
  }
}
